<?xml version="1.0"?>
<theme name="Piko" author="piko"
       desc="Stock Default, resized for a resistive touchscreen"
       version="1.0" engine_version="1" >

<!--
     Default with one thing changed: the titlebar and its buttons are big
     enough to hit with a stylus on a resistive panel.

     Default puts a 16x20 close button in the extreme top-right corner of
     the screen. That is the single worst place to put a small target on
     this digitiser: the corners are where a resistive panel is least
     linear, so taps there read a few pixels inward and miss, which is why
     closing a window "sometimes did nothing" and sometimes worked.

     So: the bar is 36px, the same height as matchbox-panel gives itself on
     this screen (panel.c:1766 picks 36 for any display taller than 320),
     and the two buttons are 48x36 blocks flush against the left and right
     screen edges. A tap anywhere in the corner block hits the button,
     including one that reads inward, which is the failure being fixed. The
     target goes from 320 to 1728 square pixels.

     Everything else (colours, fonts, the menu frame, the shadow) is
     Default's, unchanged, so this stays visually the same system.
-->

<color id="white" def="#ffffff" />
<color id="black" def="#000000" />

<color id="borderdark" def="#acaaa5" />
<color id="borderlight" def="#fcfaf5" />
<color id="bordermid" def="#bcbab5" />

<color id="grad1" def="#dadad5" />
<color id="grad2" def="#dadad5" />
<color id="grad3" def="#dadad5" />

<color id="menuborder" def="#acaaa5" />
<color id="menubg" def="#dadad5" />
<color id="menutext" def="#000000C8" />

<!-- below is menu highlight and highlighted titlebar color -->
<color id="menuhl" def="#486880" />

<color id="trans" def="#ffffff00" />
<color id="textcol" def="#ffffff" />

<color id="shadowcol"   def="#11111166" />

<font id="titlefont" def="Sans bold 16px" />
<font id="menufont" def="Sans bold 16px" />

<pixmap id="closebutton" filename="closebutton.xpm" />
<pixmap id="menubutton"  filename="menubutton.xpm" />

<frame id="main" height="36">

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="borderdark" />

  <layer x="1" y="1" w="100%-2"  h="1"
   type="plain" color="borderlight" />

  <layer x="1" y="2" w="100%-2"  h="33"
   type="plain" color="grad3"/>

  <!-- The title strip stops short of both buttons rather than running
       under them, so the button blocks read as separate targets. -->
  <layer x="50" y="4" w="100%-100"  h="28"
   type="plain" color="menuhl"/>

  <layer x="1" y="35" w="2"  h="1"
   type="plain" color="grad3" />

  <layer x="100%-3" y="35" w="2"  h="1"
   type="plain" color="grad3" />

  <!-- 16px text vertically centred in the 28px strip: 4 + (28-16)/2. -->
  <layer x="54" y="10" w="100%-108" h="20"
   type="label" color="textcol" justify="left" font="titlefont" />

  <!-- Flush to the screen edges on purpose: see the note at the top. -->
  <button x="100%-48" y="0" w="48" h="36" action="close" >
   <active pixmap="closebutton" blend="-150"/>
   <inactive pixmap="closebutton" />
  </button>

  <button x="0" y="0" w="48" h="36" action="menu" >
   <active pixmap="menubutton" blend="-150"/>
   <inactive pixmap="menubutton" />
  </button>

  <!-- Tap the title itself for the window menu.

       Explicit bounds, NOT Default's x="labelx" w="labelw". Those are not
       the label's box: labelx resolves to c->name_rendered_end_pos, the end
       of the rendered title, while labelw is the full label width. So the
       longer a window's title, the further right this button starts while
       keeping its width, and it slides over the close button -- which it
       then wins, because buttons are painted in order and this one is last,
       so it is the topmost child and the one e->subwindow reports. The
       result is a close button that cannot be tapped at all: every press in
       the corner comes back as action="menu".

       Fixed coordinates matching the label layer keep it between the two
       buttons whatever the title says. Nothing here can express
       min(labelx + labelw, 100%-48), so the bound has to be static. -->
  <button x="54" y="0" w="100%-108" h="36"
   action="menu" options="inputonly" />

</frame>

<frame id="main-east" width="4" >

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="bordermid" />

  <layer x="1" y="0" w="2"  h="100%"
   type="plain" color="grad3" />

</frame>

<frame id="main-west"  width="4" >

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="bordermid" />

  <layer x="1" y="0" w="2"  h="100%"
   type="plain" color="grad3" />

</frame>

<frame id="main-south" height="4" >

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="bordermid" />

  <layer x="1" y="1" w="100%-2"  h="100%-2"
   type="plain" color="grad3" />

  <layer x="1" y="0" w="2"  h="1"
   type="plain" color="grad3" />

  <layer x="100%-3" y="0" w="2"  h="1"
   type="plain" color="grad3" />

  <layer x="3" y="1" w="100%-6"  h="1"
   type="plain" color="borderlight" />

</frame>

<!-- Dialogs get the same treatment: their close button sat in the same
     16x20 corner and missed for the same reason. -->
<frame id="dialog" height="36" >

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="borderdark" />

  <layer x="1" y="1" w="100%-2"  h="1"
   type="plain" color="borderlight" />

  <layer x="1" y="2" w="100%-2"  h="33"
   type="plain" color="grad3"/>

  <layer x="1" y="1" w="1"  h="100%-1"
   type="gradient-vert" startcol="borderlight" endcol="grad3"/>

  <layer x="100%-2" y="1" w="1"  h="100%-1"
   type="gradient-vert" startcol="borderlight" endcol="grad3"/>

  <layer x="2" y="35" w="1"  h="1"
   type="plain" color="grad3" />

  <layer x="100%-3" y="35" w="1"  h="1"
   type="plain" color="grad3" />

  <layer x="8" y="10" w="100%-64" h="20"
   type="label" color="black" justify="left" font="titlefont" />

  <button x="-48" y="0" w="48" h="36" action="close" >
   <active pixmap="closebutton" blend="-150"/>
   <inactive pixmap="closebutton" />
  </button>

</frame>


<frame id="dialog-north" height="4">

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="borderdark" />

  <layer x="1" y="1" w="100%-2"  h="1"
   type="plain" color="borderlight" />

  <layer x="1" y="2" w="100%-2"  h="2"
   type="plain" color="grad3"/>

  <layer x="1" y="1" w="1"  h="100%-1"
   type="gradient-vert" startcol="borderlight" endcol="grad3"/>

  <layer x="100%-2" y="1" w="1"  h="100%-1"
   type="gradient-vert" startcol="borderlight" endcol="grad3"/>

</frame>

<frame id="dialog-east" width="4" >

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="bordermid" />

  <layer x="1" y="0" w="2"  h="100%"
   type="plain" color="grad3" />

</frame>

<frame id="dialog-west" width="4" >

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="bordermid" />

  <layer x="1" y="0" w="2"  h="100%"
   type="plain" color="grad3" />

</frame>

<frame id="dialog-south" height="4" >

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="bordermid" />

  <layer x="1" y="1" w="100%-2"  h="100%-2"
   type="plain" color="grad3" />

  <layer x="1" y="0" w="2"  h="1"
   type="plain" color="grad3" />

  <layer x="100%-3" y="0" w="2"  h="1"
   type="plain" color="grad3" />

  <layer x="3" y="1" w="100%-6"  h="1"
   type="plain" color="borderlight" />

</frame>

<!-- below frames are likely not needed, legacy stuff -->

<frame id="utility-max" width="36">

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="borderdark" />

  <layer x="1" y="1" w="100%-2"  h="1"
   type="plain" color="borderlight" />

  <layer x="1" y="2" w="100%-2"  h="100%-2"
   type="gradient-vert" startcol="grad1" endcol="grad2"/>

  <button x="0" y="0" w="100%" h="100%" action="minimize" options="inputonly"/>

</frame>

<frame id="utility-min" height="36">

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="borderdark" />

  <layer x="1" y="1" w="100%-2"  h="1"
   type="plain" color="borderlight" />

  <layer x="1" y="2" w="100%-2"  h="100%-2"
   type="gradient-vert" startcol="grad1" endcol="grad2"/>

  <layer x="8" y="10" w="100%-64" h="20"
   type="label" color="black" justify="left" font="titlefont" />

  <button x="0" y="0" w="100%-48" h="100%"
  action="maximize" options="inputonly"/>

  <button x="-48" y="0" w="48" h="36" action="close" >
   <active pixmap="closebutton" blend="-150"/>
   <inactive pixmap="closebutton" />
  </button>

</frame>


<frame id="menu"
        border_north="2"
	border_south="3"
	border_west="2"
        border_east="2"
        font="menufont"
	highlight="menuhl"
        color="black"
	options="shaped" >

  <layer x="0" y="0" w="100%"  h="100%"
   type="plain" color="menuborder" />

  <layer x="1" y="0" w="100%-2"  h="100%-1"
   type="plain" color="menubg" />

  <layer x="0" y="-1" w="1"  h="1"
   type="plain" color="trans" />

  <layer x="-1" y="-1" w="1"  h="1"
   type="plain" color="trans" />

</frame>

<shadow style="simple" dx="3" dy="3" color="shadowcol"/>

</theme>
